<?xml version="1.0" encoding="UTF-8"?>
<!--
    Mandatory for every Rowhouse user (HR-1). GridController is public, not
    global, and a subscriber can grant access to a managed package's public
    controller ONLY through a permission set — never a profile. Record access to
    the objects a grid shows is NOT granted here: that stays with the org's own
    profiles and permission sets, which is the point of running in user mode.
    It shows the Rowhouse app with only its Grid Guide tab: the Grid
    Admin and Grid Edit Logs tabs come with Rowhouse_Grid_Admin.
-->
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Rowhouse Grid User</label>
    <description>For everyone who uses Rowhouse grids: open grids, save, keep their own layout, write to Grid Edit Log, and the Rowhouse app with its Grid Guide. It gives no access to your records: users still need the objects and fields each grid shows.</description>
    <applicationVisibilities>
        <application>Rowhouse</application>
        <visible>true</visible>
    </applicationVisibilities>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>GridController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Grid_Action__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Grid_Child_Table__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Grid_Column__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Grid_Configuration__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Grid_Filter__mdt</name>
    </customMetadataTypeAccesses>
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Grid_Display_Rule__mdt</name>
    </customMetadataTypeAccesses>
    <fieldPermissions>
        <editable>true</editable>
        <field>Grid_Edit_Log__c.Action__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Grid_Edit_Log__c.Action_Label__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Grid_Edit_Log__c.Field__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Grid_Edit_Log__c.Field_Label__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>Grid_Edit_Log__c.Grid_Configuration__c</field>

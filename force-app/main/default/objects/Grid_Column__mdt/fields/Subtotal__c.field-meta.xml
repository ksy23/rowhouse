<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Subtotal__c</fullName>
    <label>Subtotal</label>
    <type>Picklist</type>
    <required>false</required>
    <description>What each group and the Total row show for this column, calculated over every matching record, not just the rows loaded. Sum and Average for numbers, currency and percent; Min and Max also for dates; Count (values that are not blank) for most columns. Leave blank to show nothing.</description>
    <inlineHelpText>Optional. Shown on each group and the Total row: Sum, Average, Min, Max or Count. Leave blank for none.</inlineHelpText>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>sum</fullName>
                <default>false</default>
                <label>Sum</label>
            </value>
            <value>
                <fullName>average</fullName>
                <default>false</default>
                <label>Average</label>
            </value>
            <value>
                <fullName>min</fullName>
                <default>false</default>
                <label>Min</label>
            </value>
            <value>
                <fullName>max</fullName>
                <default>false</default>
                <label>Max</label>
            </value>
            <value>
                <fullName>count</fullName>
                <default>false</default>
                <label>Count</label>
            </value>
        </valueSetDefinition>
    </valueSet>
    <fieldManageability>SubscriberControlled</fieldManageability>
</CustomField>

<?xml version="1.0" encoding="UTF-8"?>
<!-- Rowhouse — horizontal lockup
     A gable roof over three separate bars: a house, and rows of data.
     The middle bar is the row being edited.
     Geometry is fixed; do not redraw. 32-unit grid; roof x2-30 apex y3.5
     eaves y11.5; bars x2 w28 h4 r1 at y14, y20, y26.
     Wordmark: Montserrat Regular (400), all caps, tracked. Live text, with
     textLength set to Montserrat's own width so the lockup holds its
     proportions even where the font is missing. Outline it for print.
     (c) Kugamon LLC. The mark is a trademark; the software is AGPL-3.0. -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 177 32" role="img" aria-labelledby="t d">
  <title id="t">Rowhouse</title>
  <desc id="d">A gabled roof above three horizontal bars, like rows in a table. The middle bar is picked out in a contrasting color, standing for the row currently being edited. Beside it, the word ROWHOUSE.</desc>
  <path fill="#0F5C45" d="M2 11.5 L16 3.5 L30 11.5 Z"/>
  <rect x="2" y="14" width="28" height="4" rx="1" fill="#0F5C45"/>
  <rect x="2" y="20" width="28" height="4" rx="1" fill="#B3431F"/>
  <rect x="2" y="26" width="28" height="4" rx="1" fill="#0F5C45"/>
  <text x="44" y="23.6" fill="#15201C" textLength="128.9" lengthAdjust="spacingAndGlyphs"
        font-family="Montserrat, Poppins, Futura, Century Gothic, Avenir Next, system-ui, sans-serif" font-size="19" font-weight="400"
        letter-spacing="2.2">ROWHOUSE</text>
</svg>

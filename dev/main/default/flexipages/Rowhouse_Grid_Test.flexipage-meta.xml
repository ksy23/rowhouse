<?xml version="1.0" encoding="UTF-8"?>
<FlexiPage xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Development only: gridApp placed the way an admin places it, through
         Lightning App Builder, with its one setting. -->
    <description>DEVELOPMENT ONLY. gridApp placed through Lightning App Builder with the Test_Records configuration.</description>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>configName</name>
                    <value>Test_Records</value>
                </componentInstanceProperties>
                <componentName>c:gridApp</componentName>
                <identifier>c_gridApp</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
    </flexiPageRegions>
    <masterLabel>Rowhouse Grid Test</masterLabel>
    <template>
        <name>flexipage:defaultAppHomeTemplate</name>
    </template>
    <type>AppPage</type>
</FlexiPage>

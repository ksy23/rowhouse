<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Freight Limited Access</label>
    <description>DEVELOPMENT ONLY. Deliberately restricted access, used by the FLS and CRUD checks. Assign this to a suite user, NOT to a System Administrator — an admin sees everything and every access check passes vacuously.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <objectPermissions>
        <object>Consignment__c</object>
        <allowCreate>true</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>true</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Readable and editable: the happy path. -->
    <fieldPermissions><field>Consignment__c.Consignee__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Pieces__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Freight_Charge__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Ship_Date__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Delivered__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Service_Level__c</field><readable>true</readable><editable>true</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Pro_Number__c</field><readable>true</readable><editable>true</editable></fieldPermissions>

    <!-- Readable but NOT editable: the grid must render this with no edit
         affordance even though the field type allows editing, and a save that
         includes it must be rejected or stripped rather than silently applied. -->
    <fieldPermissions><field>Consignment__c.Carrier_Code__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Weight__c</field><readable>true</readable><editable>false</editable></fieldPermissions>

    <!-- Omitted entirely, and that omission is the point: Delivery_Notes__c,
         Handling_Instructions__c, Picked_Up__c, Fuel_Surcharge__c, Contact_Email__c,
         Contact_Phone__c, Tracking_Link__c, Handling__c,
         Mode__c, Equipment__c, Shipper__c and
         Delivery_Location__c are invisible to this user. None may appear in a query
         result, a rendered cell, a CSV export or a save payload. A field that
         leaks here is a security-review failure, not a cosmetic bug. -->
</PermissionSet>

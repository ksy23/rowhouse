<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Freight Read Only</label>
    <description>DEVELOPMENT ONLY. Read but never edit or create the consignments, for GridTestUsers.readOnlyUser: the object checks prove a save, an import or a new row is refused. Never assign it to a System Administrator.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Read only: no create, edit or delete. A save, an import (update and
         create) and a new row must each be refused by the object permission,
         and write nothing. -->
    <objectPermissions>
        <object>Consignment__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>
    <!-- The children can be read, but not their Amount__c (omitted below, and
         that omission is the point): the Consignment_Directory grid's Items tab is
         offered, its child total of Amount is not. -->
    <objectPermissions>
        <object>Consignment_Item__c</object>
        <allowCreate>false</allowCreate>
        <allowRead>true</allowRead>
        <allowEdit>false</allowEdit>
        <allowDelete>false</allowDelete>
        <viewAllRecords>false</viewAllRecords>
        <modifyAllRecords>false</modifyAllRecords>
    </objectPermissions>

    <!-- Readable, never editable. -->
    <fieldPermissions><field>Consignment__c.Delivered__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
    <fieldPermissions><field>Consignment__c.Mode__c</field><readable>true</readable><editable>false</editable></fieldPermissions>
